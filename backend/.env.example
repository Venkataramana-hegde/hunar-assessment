# Copy to backend/.env for local development. Every value below is also the
# built-in default, so the file is optional when running locally.

# SQLite needs no setup. For hosted Postgres such as Neon, use the pooled
# connection string instead:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite:///./candidate_comms.db

# Where the dummy communication provider is reachable.
PROVIDER_URL=http://localhost:8001

# This service's own address. The provider posts status updates back to it, so
# in a deployment it must be the public URL, not an internal host name.
APP_BASE_URL=http://localhost:8000

# Must match WEBHOOK_SECRET in provider/.env, or status updates are rejected.
PROVIDER_WEBHOOK_SECRET=local-webhook-secret

# Comma-separated list of browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:3000

# Seconds to wait on the provider. The defaults are generous because a
# suspended free-tier service can take twenty seconds or more to wake.
# PROVIDER_SEND_TIMEOUT=60
# PROVIDER_HEALTH_TIMEOUT=10
