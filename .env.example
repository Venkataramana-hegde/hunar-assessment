# Backend
DATABASE_URL=sqlite:///./candidate_comms.db
# Hosted Postgres, for example Neon. Use the pooled connection string.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require
PROVIDER_URL=http://localhost:8001
APP_BASE_URL=http://localhost:8000
PROVIDER_WEBHOOK_SECRET=local-webhook-secret
CORS_ORIGINS=http://localhost:3000

# Provider, in provider/.env (must match PROVIDER_WEBHOOK_SECRET above)
WEBHOOK_SECRET=local-webhook-secret

# Frontend (read at build time)
NEXT_PUBLIC_API_URL=http://localhost:8000
